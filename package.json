{
  "name": "claw-pay-concordium",
  "version": "0.1.0",
  "private": true,
  "description": "Claw Pay for Concordium: TypeScript workspace. Concordium testnet only.",
  "license": "MIT",
  "author": "HUMANOID-TRADERS",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build:page": "npm run build --workspace @claw-pay-concordium/verifier-page",
    "serve:page": "npm run serve --workspace @claw-pay-concordium/verifier-page --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
